# Copy this file to .env and fill in real values for your machine.
# Never commit .env — it is already listed in .gitignore.

# --- Database -----------------------------------------------------------
# Postgres connection string used by Prisma (both the CLI and the app).
DATABASE_URL="postgresql://postgres:password@localhost:5432/grouptrip_dev?schema=public"

# --- Auth (NextAuth / Auth.js) -------------------------------------------
# Random secret used to sign session/verification tokens.
# Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-generated-secret"

# Base URL the app is served from. Used to build absolute links (invite
# emails, sign-in callbacks) and by NextAuth in non-standard deployments.
APP_URL="http://localhost:3000"

# --- Outbound email (magic-link sign-in) ---------------------------------
# All four are optional. If any is missing, the app falls back to logging
# the sign-in link to the server console instead of sending a real email —
# this keeps local development and CI working without real SMTP credentials.
# Never hardcode real credentials here or anywhere in the codebase.
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="Group Trip <no-reply@example.com>"
