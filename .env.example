# SQLite by default — no setup needed.
DATABASE_URL="file:./dev.db"

# Optional: enables Claude-powered constraint reconciliation and reminder
# drafting. Without this, the app falls back to a deterministic
# rule-based version of the same logic — everything still works.
ANTHROPIC_API_KEY=

# Base URL used when building shareable trip/participant links.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
