// Prisma schema for the group holiday planning MVP.
// See ARCHITECTURE.md for the product context behind these models.

// Using the classic `prisma-client-js` generator (not the newer
// `prisma-client`) for compatibility with @auth/prisma-adapter and the
// wider ecosystem, which still expect the default `@prisma/client` export.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- Auth (NextAuth / Auth.js) ---------------------------------------------
// Shape required by @auth/prisma-adapter for the Email (magic-link) provider.

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts          Account[]
  sessions          Session[]
  organizedTrips    Trip[]            @relation("TripOrganizer")
  tripParticipation TripParticipant[]
  payments          Payment[]
  platformFees      PlatformFee[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Core product domain -----------------------------------------------

// DRAFT, COLLECTING and RECOMMENDING are all phases of planning; CONFIRMED is
// the state the organizer locks the trip into once the group has decided.
enum TripStatus {
  DRAFT
  COLLECTING
  RECOMMENDING
  CONFIRMED
  CANCELLED
}

enum ParticipantStatus {
  INVITED
  JOINED
  SUBMITTED
}

model Trip {
  id         String     @id @default(cuid())
  name       String
  status     TripStatus @default(DRAFT)
  inviteCode String     @unique @default(cuid())

  organizerId String
  organizer   User   @relation("TripOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)

  // What the group actually agreed, snapshotted when the organizer locked the
  // trip in. Held on the trip rather than recomputed, so the confirmed plan
  // keeps showing what was decided even if someone edits their preferences
  // afterwards. `confirmedDestinationId` references a seeded destination id
  // (src/lib/matching/destinations.ts), not a database row.
  confirmedDestinationId String?
  confirmedDateStart     DateTime?
  confirmedDateEnd       DateTime?
  confirmedAt            DateTime?
  confirmedCostMin       Int?
  confirmedCostMax       Int?
  // User ids of the participants whose availability covered the confirmed
  // dates at lock time — the honest basis for "N people are going".
  confirmedAttendingUserIds Json @default("[]")

  // --- Payments (see PAYMENTS.md) ---
  // Amounts are integer minor units (pence for GBP) — never floats.
  totalAmountPerPerson Int?
  initialPaymentAmount Int?
  currency             String @default("GBP")
  paymentDeadline      DateTime?
  finalPaymentDeadline DateTime?

  // Where a payment's trip money settles. Deliberately configuration rather
  // than code: the legal structure that holds customer travel money is a
  // business decision, and UNCONFIGURED (the default) means no payment can
  // be taken at all rather than money quietly resting with the platform.
  settlementMode      SettlementMode @default(UNCONFIGURED)
  settlementAccountId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants TripParticipant[]
  suggestions  DestinationSuggestion[]
  payments     Payment[]
  platformFees PlatformFee[]

  @@index([organizerId])
}

model TripParticipant {
  id     String            @id @default(cuid())
  status ParticipantStatus @default(INVITED)

  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt  DateTime?
  createdAt DateTime  @default(now())

  // --- Payments ---
  // requiredInitialPayment and totalTripAmount are snapshotted from the trip
  // when the organizer opens payments. Snapshotting is what guarantees every
  // participant is held to the same initial amount, and protects anyone who
  // has already paid from a later change to the trip's settings.
  requiredInitialPayment Int?
  totalTripAmount        Int?

  // A materialised projection of the payment ledger, recomputed from it in
  // full whenever the ledger changes — never incremented in place, so it can
  // never drift into being a second source of truth. Here so that "who still
  // owes money" is a query rather than a scan of every payment.
  initialPaymentPaid Boolean                  @default(false)
  totalAmountPaid    Int                      @default(0)
  remainingBalance   Int?
  platformFeePaid    Boolean                  @default(false)
  paymentStatus      ParticipantPaymentStatus @default(NO_PAYMENT)

  availabilityWindows AvailabilityWindow[]
  blackoutWindows     BlackoutWindow[]
  preference          Preference?
  votes               Vote[]
  payments            Payment[]
  reminders           PaymentReminder[]

  @@unique([tripId, userId])
  @@index([userId])
}

model AvailabilityWindow {
  id String @id @default(cuid())

  participantId String
  participant   TripParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  startDate DateTime
  endDate   DateTime

  @@index([participantId])
}

// Dates a participant absolutely cannot travel — a hard constraint distinct
// from (and able to carve into) their positive AvailabilityWindow ranges.
// Not yet writable from any UI; the matching engine supports it today so no
// migration is needed when that UI is added.
model BlackoutWindow {
  id String @id @default(cuid())

  participantId String
  participant   TripParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  startDate DateTime
  endDate   DateTime

  @@index([participantId])
}

model Preference {
  id String @id @default(cuid())

  participantId String          @unique
  participant   TripParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  budgetPerPerson   Int
  tripLengthMinDays Int
  tripLengthMaxDays Int
  destinationPrefs  Json     @default("[]")
  priorities        Json     @default("{}")

  // Matching-engine inputs not yet collected by any onboarding UI. Sensible
  // neutral defaults so existing rows keep working; a future preferences
  // screen can populate them without another migration.
  departureCity          String  @default("London")
  preferredClimate       String  @default("any")
  maxBudgetPerPerson     Int?
  maxFlightTimeHours     Float?
  excludedDestinationIds Json    @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A snapshot of the Group Match engine's result for one destination, at the
// time someone voted on it. Destinations themselves are seeded in code
// (src/lib/matching/destinations.ts), not stored in the database, so
// `destinationId` is a plain string matching that dataset's ids rather than
// a foreign key.
model DestinationSuggestion {
  id String @id @default(cuid())

  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  destinationId String

  suggestedDateStart DateTime
  suggestedDateEnd   DateTime
  score              Float
  scoreBreakdown     Json     @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  votes Vote[]

  @@unique([tripId, destinationId])
  @@index([tripId])
}

// One vote per participant, for the whole trip — a participant picks a single
// preferred destination and can change it (the row is updated in place) until
// the organizer locks the trip. The unique constraint on `participantId` is
// what makes "can't vote twice" a database guarantee rather than an
// application-level check that concurrent requests could race past.
model Vote {
  id String @id @default(cuid())

  participantId String          @unique
  participant   TripParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  suggestionId String
  suggestion   DestinationSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([suggestionId])
}


// --- Payments ---------------------------------------------------------------
// See PAYMENTS.md for the architecture behind these models. Every money
// column is an integer in the currency's minor unit (pence for GBP).

enum SettlementMode {
  UNCONFIGURED
  CONNECTED_ACCOUNT
  PLATFORM_BALANCE
}

/// The lifecycle of one card charge.
enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

/// A participant's overall position on a trip, derived from the ledger.
enum ParticipantPaymentStatus {
  NO_PAYMENT
  INITIAL_PAYMENT_PENDING
  INITIAL_PAYMENT_PAID
  PARTIALLY_PAID
  FULLY_PAID
  PAYMENT_FAILED
  PAYMENT_OVERDUE
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentKind {
  INITIAL
  ADDITIONAL
}

enum PlatformFeeStatus {
  PENDING
  CHARGED
  REFUNDED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// One card charge. Money columns are written once at creation and never
/// rewritten — a correction is a new row (a Refund), never an edit.
model Payment {
  id String @id @default(cuid())

  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  participantId String
  participant   TripParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  /// Trip money. This, and only this, counts towards the trip balance.
  amount Int
  /// Our one-time fee. Zero on every payment after the first.
  platformFee Int    @default(0)
  /// amount + platformFee — what the card was actually charged.
  totalCharged Int
  currency     String

  kind   PaymentKind
  status PaymentStatus @default(PENDING)

  /// Stripe's hosted Checkout Session. The participant pays on Stripe's page,
  /// so this is the only handle we have until the session produces an intent.
  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String? @unique
  stripeChargeId          String?
  /// Where to send the participant to finish paying. Kept so a refresh, or
  /// coming back later, resumes the same payment instead of starting another.
  checkoutUrl String?
  /// Deterministic per attempt, so a retry can never create a second charge.
  idempotencyKey String @unique
  failureCode    String?
  failureMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  platformFeeRecord PlatformFee?
  refunds           Refund[]
  events            PaymentEvent[]

  @@index([tripId, userId])
  @@index([participantId])
}

/// Our fee, recorded separately from the trip money it rode in with. The
/// unique constraint on (tripId, userId) is what makes "charged once per
/// participant per trip" a database guarantee rather than a check that two
/// concurrent requests could race past.
model PlatformFee {
  id String @id @default(cuid())

  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount   Int
  currency String

  paymentId String  @unique
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  status PlatformFeeStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tripId, userId])
}

/// A refund, split into the two kinds of money it returns. Keeping them apart
/// is what lets us return someone's trip money without returning our fee, or
/// return both, as a recorded decision rather than an accident of arithmetic.
model Refund {
  id String @id @default(cuid())

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  /// Trip money returned — the part that moves the balance back.
  tripAmount Int
  /// Platform fee returned. Usually zero.
  platformFeeAmount Int    @default(0)
  currency          String

  stripeRefundId String? @unique
  status         RefundStatus @default(PENDING)
  reason         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId])
}

/// Append-only audit trail. Every status change a payment ever made, and the
/// Stripe event that caused it.
model PaymentEvent {
  id String @id @default(cuid())

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  fromStatus    PaymentStatus?
  toStatus      PaymentStatus
  stripeEventId String?
  detail        String?

  createdAt DateTime @default(now())

  @@index([paymentId])
}

/// Every Stripe event we have processed, keyed by Stripe's own id. Inserting
/// here first is what makes a redelivered webhook a no-op instead of a second
/// state transition.
model WebhookEvent {
  /// Stripe's event id (evt_...).
  id   String @id
  type String

  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?
}

/// A reminder that has been sent, recorded so it is never sent twice for the
/// same deadline.
///
/// Nothing writes to this table yet — reminders are not implemented, only
/// prepared (src/lib/payments/reminders.ts decides who is due). It exists
/// because idempotency is the part a sender cannot retrofit safely: without
/// a record of what went out, an hourly job chases the same person hourly.
model PaymentReminder {
  id String @id @default(cuid())

  participantId String
  participant   TripParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  /// Matches ReminderReason in src/lib/payments/reminders.ts.
  reason String
  /// The deadline this reminder was about, so a later deadline can re-remind.
  dueAt  DateTime

  sentAt DateTime @default(now())
  /// "email", "push" — whichever transport eventually sends it.
  channel String?

  /// One reminder per participant, per reason, per deadline.
  @@unique([participantId, reason, dueAt])
  @@index([participantId])
}
